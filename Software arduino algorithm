#define USER_EMAIL "smartirrigation@gmail.com"
#define USER_PASSWORD "SmartIrrigation123"

#define DATABASE_URL "https://smart-irrigation-4b224-default-rtdb.asia-southeast1.firebasedatabase.app"

// =====================================================
// 3. SENSOR PINS
// =====================================================

#define DHTPIN 4
#define DHTTYPE DHT11
#define SOIL_PIN 34
#define RELAY_PIN 25

// Soil sensor calibration

#define SOIL_THRESHOLD 2400

// =====================================================
// 4. TIMING
// =====================================================

// Save a reading every 30 seconds
const unsigned long UPLOAD_INTERVAL = 30000;

unsigned long lastUpload = 0;

// =====================================================
// 5. SENSOR AND FIREBASE OBJECTS
// =====================================================

DHT dht(DHTPIN, DHTTYPE);

UserAuth user_auth(
  API_KEY,
  USER_EMAIL,
  USER_PASSWORD,
  3000
);

FirebaseApp app;
WiFiClientSecure ssl_client;

using AsyncClient = AsyncClientClass;
AsyncClient aClient(ssl_client);

RealtimeDatabase Database;

// =====================================================
// 6. FIREBASE RESULT CALLBACK
// =====================================================

void processData(AsyncResult &result) {
  if (result.isError()) {
    Serial.print("Firebase error: ");
    Serial.print(result.error().code());
    Serial.print(" - ");
    Serial.println(result.error().message());
  }

  if (result.isDebug()) {
    Serial.println(result.debug());
  }

  if (result.available()) {
    Serial.print("Firebase response: ");
    Serial.println(result.c_str());
  }
}

// =====================================================
// 7. SETUP
// =====================================================

void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println();
  Serial.println("==================================");
  Serial.println(" SMART IRRIGATION + DATA HISTORY");
  Serial.println("==================================");

  // Initialize sensors and relay
  dht.begin();
  pinMode(SOIL_PIN, INPUT);
  pinMode(RELAY_PIN, OUTPUT);

  // Active LOW relay: HIGH = OFF
  digitalWrite(RELAY_PIN, HIGH);

  // Connect Wi-Fi
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  Serial.print("Connecting to Wi-Fi");

  int attempts = 0;

  while (WiFi.status() != WL_CONNECTED && attempts < 40) {
    delay(500);
    Serial.print(".");
    attempts++;
  }

  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("\nWi-Fi connection failed.");
    Serial.println("Check your Wi-Fi credentials.");
    return;
  }

  Serial.println("\nWi-Fi connected.");
  Serial.print("IP address: ");
  Serial.println(WiFi.localIP());

  // Synchronize time using NTP
  configTime(0, 0, "pool.ntp.org", "time.nist.gov");

  Serial.print("Synchronizing clock");

  time_t now = time(nullptr);
  attempts = 0;

  while (now < 1700000000 && attempts < 30) {
    delay(500);
    Serial.print(".");
    now = time(nullptr);
    attempts++;
  }

  Serial.println();

  if (now >= 1700000000) {
    Serial.println("Network time synchronized.");
  } else {
    Serial.println("WARNING: Clock not synchronized.");
    Serial.println("History writes will be skipped until time is valid.");
  }

  // Firebase setup
  ssl_client.setInsecure();
  ssl_client.setTimeout(15000);
  ssl_client.setHandshakeTimeout(15);

  initializeApp(
    aClient,
    app,
    getAuth(user_auth),
    120000,
    processData
  );

  app.getApp<RealtimeDatabase>(Database);
  Database.url(DATABASE_URL);

  Serial.println("Firebase initialization started.");
}

// =====================================================
// 8. MAIN LOOP
// =====================================================

void loop() {
  // Required to keep Firebase authentication and requests running
  app.loop();

  // Read sensors
  float temperature = dht.readTemperature();
  float humidity = dht.readHumidity();
  int soilValue = analogRead(SOIL_PIN);

  // Check DHT11
  if (isnan(temperature) || isnan(humidity)) {
    Serial.println("DHT11 read failed; skipping this cycle.");
    delay(1000);
    return;
  }

  // Determine irrigation status
  String soilStatus;
  String pumpStatus;

  if (soilValue > SOIL_THRESHOLD) {
    soilStatus = "DRY";
    pumpStatus = "ON";
    digitalWrite(RELAY_PIN, LOW);
  } else {
    soilStatus = "WET";
    pumpStatus = "OFF";
    digitalWrite(RELAY_PIN, HIGH);
  }

  // Display current readings
  Serial.println("\n----------------------------------");
  Serial.print("Temperature: ");
  Serial.print(temperature, 2);
  Serial.println(" C");

  Serial.print("Humidity: ");
  Serial.print(humidity, 2);
  Serial.println(" %");

  Serial.print("Soil moisture: ");
  Serial.println(soilValue);

  Serial.print("Soil status: ");
  Serial.println(soilStatus);

  Serial.print("Pump status: ");
  Serial.println(pumpStatus);

  Serial.print("Firebase ready: ");
  Serial.println(app.ready() ? "YES" : "NO");

  // Upload on the chosen interval
  if (app.ready() &&
      (lastUpload == 0 ||
       millis() - lastUpload >= UPLOAD_INTERVAL)) {

    lastUpload = millis();

    time_t now = time(nullptr);

    if (now < 1700000000) {
      Serial.println("Skipping upload: timestamp is invalid.");
    } else {
      String timestamp = String((long long)now);

      // Update latest sensor values
      object_t sensorsData(
        String("{") +
        "\"soilMoisture\":" + String(soilValue) +
        ",\"temperature\":" + String(temperature, 2) +
        ",\"humidity\":" + String(humidity, 2) +
        ",\"soilStatus\":\"" + soilStatus + "\"" +
        "}"
      );

      // Update latest pump status
      object_t pumpData(
        String("{") +
        "\"status\":\"" + pumpStatus + "\"" +
        "}"
      );

      // Update system timestamp
      object_t systemData(
        String("{") +
        "\"lastUpdate\":" + timestamp +
        "}"
      );

      // Create a separate historical record
      object_t historyData(
        String("{") +
        "\"timestamp\":" + timestamp +
        ",\"soilMoisture\":" + String(soilValue) +
        ",\"temperature\":" + String(temperature, 2) +
        ",\"humidity\":" + String(humidity, 2) +
        ",\"soilStatus\":\"" + soilStatus + "\"" +
        ",\"pumpStatus\":\"" + pumpStatus + "\"" +
        "}"
      );

      // Update existing current-value nodes
      Database.set<object_t>(
        aClient, "/sensors", sensorsData, processData, "sensors"
      );

      Database.set<object_t>(
        aClient, "/pump", pumpData, processData, "pump"
      );

      Database.set<object_t>(
        aClient, "/system", systemData, processData, "system"
      );

      // Append history under a unique timestamp key
      String historyPath = "/history/" + timestamp;

      Database.set<object_t>(
        aClient, historyPath, historyData, processData, "history"
      );

      Serial.print("Upload requests submitted for timestamp: ");
      Serial.println(timestamp);
    }
  }

  // Allow time for asynchronous processing
  delay(1000);
}
